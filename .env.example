# Copy to .env to override. docker compose loads .env.example first, then .env (D4).
# NO secrets belong in this repository. Put real provider keys only in your local .env.

# ---- LLM provider (any OpenAI-compatible /chat/completions endpoint)
# Default: the bundled stub (no key needed). To use a real free-tier provider, set these three in .env.
# Leave LLM_BASE_URL empty to run with NO model at all (deterministic fallback path).
LLM_BASE_URL=http://llm-stub:9000/v1
LLM_MODEL=stub-model
LLM_API_KEY=not-needed
LLM_TIMEOUT_S=15
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
CB_FAILURE_THRESHOLD=4
CB_RESET_S=30
# cost accounting: USD per 1k tokens for your provider (0 on a free tier)
LLM_PRICE_PROMPT_PER_1K=0
LLM_PRICE_COMPLETION_PER_1K=0

# ---- stub behaviour (load tests)
STUB_DELAY_MS=800
STUB_JITTER_MS=300

# ---- retrieval / embeddings (local, free). EMBEDDING_BACKEND=st|hash (hash = no model download, lower quality)
EMBEDDING_BACKEND=st
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MODE=agentic
PROMPT_VERSION=v1

# ---- agent budgets (A1)
RUN_MAX_STEPS=25
RUN_MAX_TOOL_CALLS=30
RESEARCH_TIMEOUT_S=60
ASSESS_TIMEOUT_S=40
RUN_DEADLINE_S=180
WORKER_MAX_ATTEMPTS=2
WORKER_CONCURRENCY=4

# ---- cache / rate limit (D7)
CACHE_ENABLED=true
CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=30

# ---- safety / testing
ALLOW_FAULT_INJECTION=true   # demo only: enables ?fault=unsupported|persistent on POST /v1/runs. Set false in production.
QUALITY_SAMPLE_RATE=0.3

# ---- observability
LOG_LEVEL=INFO
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---- plumbing (compose service names; change if you rename services)
REDIS_URL=redis://redis:6379/0
INDEX_DIR=/data/index
CORPUS_DIR=/app/corpus/raw
METRICS_PORT=8001

# ---- optional Streamlit frontend (compose sets this to http://api:8000)
FSSAI_API_BASE_URL=http://127.0.0.1:8000
