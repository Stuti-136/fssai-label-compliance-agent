{
 "uid": "fssai-main",
 "title": "FSSAI label compliance - service",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Run end-to-end latency p50 / p95 (submission -> result)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(run_e2e_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(run_e2e_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Throughput (runs/s): submitted vs completed",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(runs_submitted_total[1m]))",
     "legendFormat": "submitted",
     "refId": "A"
    },
    {
     "expr": "sum(rate(run_e2e_seconds_count[1m]))",
     "legendFormat": "completed",
     "refId": "B"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error rate: API 5xx %, agent run errors/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100*sum(rate(api_requests_total{status=~\"5..\"}[1m]))/clamp_min(sum(rate(api_requests_total[1m])),1e-9)",
     "legendFormat": "API 5xx %",
     "refId": "A"
    },
    {
     "expr": "sum(rate(agent_runs_total{outcome=\"error\"}[1m]))",
     "legendFormat": "agent errors/s",
     "refId": "B"
    },
    {
     "expr": "sum(rate(rate_limited_total[1m]))",
     "legendFormat": "429/s",
     "refId": "C"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Availability (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up",
     "legendFormat": "{{job}} {{instance}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "API latency p95 by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(api_request_seconds_bucket[1m])) by (le, route))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "queue_depth",
     "legendFormat": "{{queue}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Agent task success rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(agent_runs_total{outcome=~\"ok\"}[5m])) by (agent)/sum(rate(agent_runs_total[5m])) by (agent)",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Steps per run (avg)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(agent_run_steps_sum[5m])) by (agent)/sum(rate(agent_run_steps_count[5m])) by (agent)",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tool calls per run (avg)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(agent_run_tool_calls_sum[5m])) by (agent)/sum(rate(agent_run_tool_calls_count[5m])) by (agent)",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Agent run latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(agent_run_seconds_bucket[1m])) by (le, agent))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Per-step latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(agent_step_seconds_bucket[1m])) by (le, agent, step))",
     "legendFormat": "{{agent}} {{step}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "LLM retry rate & circuit state (2=open)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(llm_retries_total[1m]))/clamp_min(sum(rate(llm_calls_total[1m])),1e-9)",
     "legendFormat": "retry rate",
     "refId": "A"
    },
    {
     "expr": "max(llm_circuit_state)",
     "legendFormat": "breaker state",
     "refId": "B"
    },
    {
     "expr": "sum(rate(llm_calls_total[1m])) by (outcome)",
     "legendFormat": "calls {{outcome}}",
     "refId": "C"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Container uptime (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "time() - process_start_time_seconds",
     "legendFormat": "{{job}} {{instance}}",
     "refId": "A"
    },
    {
     "expr": "time() - container_start_time_seconds{name=~\".+\"}",
     "legendFormat": "{{name}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Container CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m])) by (name)",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Container memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "container_memory_working_set_bytes{name=~\".+\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "LLM cost USD / hour by step (largest driver)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(llm_cost_usd_total[1h])) by (step)",
     "legendFormat": "{{step}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Tokens/s by step",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(llm_tokens_total[1m])) by (step, kind)",
     "legendFormat": "{{step}} {{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(cache_events_total{result=\"hit\"}[5m])) by (kind)/sum(rate(cache_events_total[5m])) by (kind)",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Live quality score (sampled)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "quality_score",
     "legendFormat": "{{metric}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Guardrails & rejects",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(guardrail_events_total[5m])) by (type)",
     "legendFormat": "guard {{type}}",
     "refId": "A"
    },
    {
     "expr": "sum(rate(runs_rejected_total[5m])) by (reason)",
     "legendFormat": "reject {{reason}}",
     "refId": "B"
    },
    {
     "expr": "sum(rate(verification_total[5m])) by (outcome)",
     "legendFormat": "verify {{outcome}}",
     "refId": "C"
    }
   ]
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Index freshness: age (s), chunks, build throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "time() - max(index_built_timestamp_seconds)",
     "legendFormat": "index age s",
     "refId": "A"
    },
    {
     "expr": "max(index_chunks)",
     "legendFormat": "chunks",
     "refId": "B"
    },
    {
     "expr": "max(index_build_chunks_per_second)",
     "legendFormat": "chunks/s at build",
     "refId": "C"
    }
   ]
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Feedback",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(feedback_total[1h])) by (satisfactory)",
     "legendFormat": "satisfactory={{satisfactory}}",
     "refId": "A"
    }
   ]
  }
 ]
}